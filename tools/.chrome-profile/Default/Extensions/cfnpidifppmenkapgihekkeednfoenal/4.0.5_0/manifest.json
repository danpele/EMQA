   "manifest_version": 3,
   "name": "__MSG_main_extension_name__",
   "permissions": [ "downloads", "alarms", "scripting", "browsingData", "idle", "tabs", "activeTab", "declarativeNetRequest", "history", "contentSettings", "storage", "bookmarks", "webNavigation", "webRequest", "nativeMessaging", "identity", "sidePanel" ],
   "side_panel": {
      "default_path": "modules/main/foreground/popup/sidepanel.html"
   },
   "sidebar_action": {
      "default_icon": "res/main/icons/icon48.png",
      "default_panel": "modules/main/foreground/popup/sidepanel.html",
      "default_title": "__MSG_main_extension_name__"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "4.0.5",
   "web_accessible_resources": [ {
      "matches": [ "http://*/*", "https://*/*" ],
      "resources": [ "res/urlScanning/*.svg" ]
   }, {
      "matches": [ "https://web.whatsapp.com/*", "https://www.messenger.com/*", "https://www.facebook.com/*", "https://web.telegram.org/*", "https://discord.com/*", "https://www.linkedin.com/*" ],
      "resources": [ "modules/searchAdvisor/foreground/*.css" ]
   }, {
      "matches": [ "http://*/*", "https://*/*" ],
      "resources": [ "modules/adDetection/foreground/contentScripts/adDetectionStyles.css", "modules/adDetection/res/ad_whitelist.json" ]
   }, {
      "matches": [ "http://*/*", "https://*/*" ],
      "resources": [ "modules/pageIntervention/foreground/suspiciousWarning/suspiciousWarning.css", "modules/pageIntervention/foreground/permissionsToast/permissionsToast.css", "modules/pageIntervention/foreground/blockingPage/blocked.html", "modules/pageIntervention/foreground/blockingPage/blocked.css", "modules/pageIntervention/foreground/blockingPage/blocked.js", "modules/pageIntervention/foreground/contentScripts/signInReminderToast.css" ]
   }, {
      "matches": [ "http://*/*", "https://*/*", "ftp://*/*" ],
      "resources": [ "res/searchAdvisor/*.png", "res/searchAdvisor/*.gif", "res/searchAdvisor/*.svg", "modules/searchAdvisor/foreground/contentScripts/*.css", "_locales/*.json" ]
   }, {
      "matches": [ "http://*/*", "https://*/*", "ftp://*/*" ],
      "resources": [ "res/**/*.svg", "res/**/*.png", "_locales/**/*.json" ]
   } ]
}
